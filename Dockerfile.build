
FROM node:22-bookworm-slim

ENV CI=true
WORKDIR /workspace

# Pin pnpm to the version used by this repository.
RUN npm install --global pnpm@11.22.0

# Root build context is required for workspace packages.
COPY . .

# Respect the repository's lockfile and pnpm workspace policy.
RUN pnpm install --frozen-lockfile

# Validate the actual monorepo build, including Turbo dependencies.
RUN pnpm run build
