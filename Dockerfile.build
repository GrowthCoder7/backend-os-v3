FROM docker.io/library/node:22-bookworm-slim

# FIX: Install OpenSSL required by Prisma's Rust engines in slim images
RUN apt-get update -y && apt-get install -y openssl procps

WORKDIR /workspace

RUN npm install --global pnpm@11.22.0

COPY . .

RUN pnpm install --frozen-lockfile

# Validate the actual monorepobuild, including Turbo dependencies.
RUN pnpm run build